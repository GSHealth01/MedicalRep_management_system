// ===============================
// Prisma Schema
// ===============================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===============================
// SECTOR (Agency and Range combined)
// ===============================

model sector {
  id           Int           @id @default(autoincrement())
  agency       String        // REQUIRED
  range        String        // A or B
  dateAdded    DateTime?     @default(now())

  users        user[]
  teams        team[]
  doctors      doctor[]
  distributors distributor[]
}

// ===============================
// TEAM — Roles & Structure
// ===============================

model team {
  id                      Int      @id @default(autoincrement())
  name                    String   @map("team_name") // REQUIRED

  operations_manager      String?
  senior_manager          String?
  territory_managers      String?
  product_managers        String?
  senior_executives       String?
  junior_executives       String?
  field_coordinators      String?
  medical_representatives String?

  dateAdded DateTime?     @default(now())

  // TEAM → SECTOR
  sector_id  Int
  sector     sector       @relation(fields: [sector_id], references: [id])

  // TEAM → USERS (Team has many MRs)
  users      user[]

  // TEAM ↔ PRODUCT (Many-to-many)
  products   TeamProducts[]
}

// ===============================
// AREA (territories for distributors)
// ===============================

model area {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  dateAdded DateTime? @default(now())

  distributor distributor?
  users       UserWorkAreas[]
}

// ===============================
// DISTRIBUTOR
// ===============================

model distributor {
  distributor_code String @id
  name             String? @map("distributor_name")
  coverage_town    String?
  route            String?
  dateAdded        DateTime? @default(now())

  sector_id        Int
  sector           sector @relation(fields: [sector_id], references: [id])

  area_id          Int
  area             area   @relation(fields: [area_id], references: [id])

  products         DistributorProducts[]
  users            UserDistributors[]

  @@unique([area_id]) // One area → One distributor
}

// ===============================
// USER (MR / TM / Manager / Staff)
// ===============================

model user {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  name        String?
  emp_no      String    @unique
  designation String?
  join_date   DateTime?
  birthday    DateTime?
  dateAdded   DateTime? @default(now())

  security_question String?
  security_answer   String?

  sector_id Int?
  sector    sector? @relation(fields: [sector_id], references: [id])

  team_id   Int?
  team      team?   @relation(fields: [team_id], references: [id])

  distributors UserDistributors[]
  work_areas   UserWorkAreas[]
  doctors      UserDoctors[]
  itineraries  itinerary[]
}

// ===============================
// DOCTOR
// ===============================

model doctor {
  id             Int      @id @default(autoincrement())
  name           String
  contactNumber  String?
  email          String?
  specialty      String?
  categorization String?
  dateAdded      DateTime? @default(now())

  sector_id      Int?
  sector         sector? @relation(fields: [sector_id], references: [id])

  users          UserDoctors[]
  prescriptions  DoctorPrescriptions[]
}

// ===============================
// PRODUCT
// ===============================

model product {
  id                      Int      @id @default(autoincrement())
  name                    String
  therapeutic_category    String?
  generic_name            String?
  route_of_administration String?
  pack_size               String?
  strength                String?
  dateAdded               DateTime? @default(now())

  distributors            DistributorProducts[]
  doctors                 DoctorPrescriptions[]
  teams                   TeamProducts[]
}

// ===============================
// M:N Junction Tables
// ===============================

model UserWorkAreas {
  user    user @relation(fields: [user_id], references: [id])
  user_id Int

  area    area @relation(fields: [area_id], references: [id])
  area_id Int

  @@id([user_id, area_id])
}

model UserDistributors {
  user             user        @relation(fields: [user_id], references: [id])
  user_id          Int

  distributor      distributor @relation(fields: [distributor_code], references: [distributor_code])
  distributor_code String

  @@id([user_id, distributor_code])
}

model UserDoctors {
  user      user   @relation(fields: [user_id], references: [id])
  user_id   Int

  doctor    doctor @relation(fields: [doctor_id], references: [id])
  doctor_id Int

  @@id([user_id, doctor_id])
}

model DistributorProducts {
  distributor      distributor @relation(fields: [distributor_code], references: [distributor_code])
  distributor_code String

  product          product     @relation(fields: [product_id], references: [id])
  product_id       Int

  @@id([distributor_code, product_id])
}

model DoctorPrescriptions {
  doctor     doctor  @relation(fields: [doctor_id], references: [id])
  doctor_id  Int

  product    product @relation(fields: [product_id], references: [id])
  product_id Int

  @@id([doctor_id, product_id])
}

model TeamProducts {
  team       team    @relation(fields: [team_id], references: [id])
  team_id    Int

  product    product @relation(fields: [product_id], references: [id])
  product_id Int

  @@id([team_id, product_id])
}

// ===============================
// ITINERARY (Monthly MR plan)
// ===============================

model itinerary {
  id          Int      @id @default(autoincrement())
  repName     String
  month       String
  distributor String    // kept as plain text (you requested)
  town        String?   // Town field
  status      String?   @default("pending")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user_id     Int
  user        user     @relation(fields: [user_id], references: [id])

  entries     itineraryEntry[]

  @@map("itineraries")
}

// ===============================
// ITINERARY ENTRY (Daily visits)
// ===============================

model itineraryEntry {
  id           Int       @id @default(autoincrement())
  date         String
  dayNo        Int
  area         String?
  town         String?
  doctorCalls  Int?      @default(0)
  chemistCalls Int?      @default(0)
  mileage      Float?    @default(0.0)
  nightOutArea String?

  itinerary_id Int
  itinerary    itinerary @relation(fields: [itinerary_id], references: [id], onDelete: Cascade)

  @@map("itinerary_entries")
}
